// CRMgold data model — PostgreSQL (Supabase).
// DATABASE_URL is the pooled connection (transaction pooler, port 6543, used by
// the app / serverless functions); DIRECT_URL is the session pooler (port 5432,
// used only by `prisma migrate`). See DEPLOY.md / server/.env.example.

generator client {
  provider      = "prisma-client-js"
  // Generate into the source tree (not node_modules) so the serverless bundler
  // ships the client and its query engine. binaryTargets covers Vercel's runtime.
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A currency the business trades or spends in. Every trade/expense/capital
/// amount is stored in that record's own currency; `fxRate` converts it to the
/// base currency (isBase = true) for all reporting: amount_in_base = amount * fxRate.
model Currency {
  id            String    @id @default(cuid())
  code          String    @unique // "AED", "USD", "THB", "IDR", …
  symbol        String // "AED", "$", "฿", "Rp"
  decimals      Int       @default(2) // IDR = 0
  isBase        Boolean   @default(false) // exactly one; the reporting currency
  /// Today's rate: base-currency units per 1 unit of this currency
  /// (amount_in_base = amount * rate). The admin updates this daily; a new
  /// trade/expense in this currency pre-fills its fxRate from here.
  rate          Float     @default(1)
  rateUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
}

/// Login accounts. One ADMIN (seeded) plus one auto-created account per investor.
model User {
  id         String    @id @default(cuid())
  username   String    @unique
  password   String // bcrypt hash
  role       String    @default("INVESTOR") // ADMIN | INVESTOR
  status     String    @default("ACTIVE") // ACTIVE | INVALID  (admin can invalidate an investor login)
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: Cascade)
  investorId String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// A person who has invested capital and receives a percentage share of profit.
model Investor {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  sharePercentage Float    @default(0) // 0 - 100
  capitalInvested Float    @default(0) // informational, in `currencyCode`
  currencyCode    String   @default("AED")
  fxRate          Float    @default(1) // capitalInvested * fxRate = capital in base currency
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE
  notes           String?
  joinedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User?
  expenses Expense[]
  partners ProfitPartner[]

  /// Plaintext of the most recently generated password, kept so the admin can
  /// re-share credentials. Cleared once the admin marks it as delivered.
  generatedUsername String?
  generatedPassword String?
}

/// A second-level split of ONE investor's profit share. If an investor has no
/// partners they keep 100% of their share (the original behaviour). If they
/// have partners, the partner `percentage` values must total 100 and the
/// investor's net share (profit or loss) is divided among them by percentage.
model ProfitPartner {
  id         String   @id @default(cuid())
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  investorId String
  name       String
  role       String? // free text: "Capital", "Operator", "Sleeping partner", …
  percentage Float // 0–100, of the investor's net profit share
  createdAt  DateTime @default(now())

  @@index([investorId])
}

/// Expense headers. "Flight", "Total Travel", "Visa", "Hotel Bookings" are seeded;
/// admin can add / rename / delete their own headers.
model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id           String          @id @default(cuid())
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId   String
  amount       Float // in `currencyCode`
  currencyCode String          @default("AED")
  fxRate       Float           @default(1) // amount * fxRate = amount in base currency
  date         DateTime
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attachments ExpenseAttachment[]

  /// Optional investor this expense relates to.
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)
  investorId String?
  /// When true (and investorId set) this expense is deducted from that
  /// investor's profit share only, not from the shared pool.
  chargedToInvestor Boolean @default(false)
}

/// Payment slip / invoice / receipt attached to an expense (image or PDF).
model ExpenseAttachment {
  id           String   @id @default(cuid())
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId    String
  blobUrl      String // public Vercel Blob URL (random suffix — unguessable)
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
}

/// A single gold purchase (BUY) or sale (SELL). "quality" is the purity grade.
model GoldTransaction {
  id            String   @id @default(cuid())
  type          String // BUY | SELL
  date          DateTime
  quality       String // e.g. "24K", "22K", "999", "916"
  quantityGrams Float
  ratePerGram   Float // in `currencyCode`
  totalAmount   Float // quantityGrams * ratePerGram, in `currencyCode`
  currencyCode  String  @default("AED")
  fxRate        Float   @default(1) // ratePerGram/totalAmount * fxRate = value in base currency
  counterparty  String? // supplier / buyer name
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
