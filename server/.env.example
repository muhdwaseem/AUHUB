# Copy this file to .env  (server/.env)  before running the app locally.

# PostgreSQL (Supabase). From Supabase → Settings → Database → Connection string → URI:
#   DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = Session pooler     (port 5432, same *.pooler.supabase.com host)
# Do NOT use the raw db.<ref>.supabase.co host for DIRECT_URL — it's IPv6-only on
# the free tier and `prisma migrate` can't reach it.
DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Long random string — sign your own, e.g.  node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET="change-this-to-a-long-random-string"

# File storage. Auto-provisioned when you add Blob storage to the Vercel project;
# for local dev, create a token in the Vercel dashboard (Storage → your Blob store → tokens).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Local API port (ignored on Vercel).
PORT=4000

# Only needed if the client is served from a DIFFERENT origin than the API.
# On a single Vercel deploy the client and API share an origin, so leave the default.
CORS_ORIGIN="http://localhost:5173"
