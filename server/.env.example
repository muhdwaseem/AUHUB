# Copy this file to .env  (server/.env)  before running the app locally.

# PostgreSQL. On Vercel + Neon:
#   DATABASE_URL = the POOLED connection string (…-pooler…, ?sslmode=require)
#   DIRECT_URL   = the DIRECT connection string  (no -pooler, ?sslmode=require)
# Locally you can point both at the same DB (a free Neon database, or a local
# `docker run -e POSTGRES_PASSWORD=pw -p 5432:5432 postgres:16`).
DATABASE_URL="postgresql://user:pass@host-pooler.region.neon.tech/crmgold?sslmode=require"
DIRECT_URL="postgresql://user:pass@host.region.neon.tech/crmgold?sslmode=require"

# Long random string — sign your own, e.g.  node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET="change-this-to-a-long-random-string"

# File storage. Auto-provisioned when you add Blob storage to the Vercel project;
# for local dev, create a token in the Vercel dashboard (Storage → your Blob store → tokens).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Local API port (ignored on Vercel).
PORT=4000

# Only needed if the client is served from a DIFFERENT origin than the API.
# On a single Vercel deploy the client and API share an origin, so leave the default.
CORS_ORIGIN="http://localhost:5173"
